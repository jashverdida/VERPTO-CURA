# ============================================
# GOOGLE MAPS API KEY (Required)
# ============================================
# Get your API key from: https://console.cloud.google.com/apis/credentials
#
# Steps:
# 1. Go to Google Cloud Console
# 2. Create a new API key
# 3. Enable "Maps JavaScript API" for this key
# 4. Set HTTP referrer restrictions to allow localhost:
#    - http://localhost:3000/*
#    - http://localhost:5173/*
# 5. Copy the key below
#
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# SUPABASE (Optional - for backend integration)
# ============================================
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# OPENAI — GPT-5-mini Escalation & Triage AI
# ============================================
# Get your key from: https://platform.openai.com/api-keys
#
# IMPORTANT: No VITE_ prefix — this key must NEVER be exposed to the browser.
# It is used only inside the Supabase Edge Function (server-side).
# Store the real value in your local .env file (which is gitignored).
# In production, store it in Supabase Vault instead.
#
OPENAI_API_KEY=your_openai_api_key_here

# FOR LOCAL AI TEST LAB ONLY — same key, with VITE_ prefix so the browser can
# reach it during development. Never deploy this to a public server.
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# OPENAI — Mobile (Expo / React Native)
# ============================================
# Add this to mobile/.env (gitignored) for the Responder app.
# Expo exposes EXPO_PUBLIC_ prefixed vars to the JS bundle.
# EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here